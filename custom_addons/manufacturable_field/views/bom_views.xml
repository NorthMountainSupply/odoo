<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the mrp.bom form view -->
    
    <record id="view_bom_form_inherit" model="ir.ui.view">
        <field name="name">bom.form.inherit</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[field[@name='product_qty']]" position="after">
                <field name="manufacturable"/>
                <label for="limiting_product_manufacturable" string="Limited By"/>
                <div class="o_row">
                    <field name="limiting_product_manufacturable"/>
                    <field name="limiting_product_id"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>